/*
 * PSE em Ação - Sistema de Planejamento e Acompanhamento de Ações de Saúde na Escola
 * AEP - 2º semestre de 2026 - Linguagem C
 *
 * Observações:
 * - Usa apenas dados fictícios e coletivos (nenhum dado individual de estudante).
 * - Os dados ficam somente na memória: ao encerrar o programa, tudo é perdido.
 * - Login de demonstração: usuário "admin" e senha "1234".
 */

#include <stdio.h>
#include <stdlib.h>    /* exit()                                           */
#include <limits.h>    /* INT_MAX                                          */
#ifdef _WIN32
#include <windows.h>   /* SetConsoleOutputCP() - acentos no Windows        */
#endif

#define MAX_ACOES 20   /* quantidade máxima de ações que cabem na memória */
#define TAM_TEXTO 50   /* tamanho máximo dos textos (escola, tema, etc.)   */
#define TAM_DATA 11    /* dd/mm/aaaa + caractere final                     */
#define TAM_LINHA 100  /* tamanho da linha usada para ler números          */

#define PLANEJADA 1
#define REALIZADA 2
#define CANCELADA 3

/* ---------- Dados das ações (vetores e matrizes; a posição i é a ação i) ---------- */
int codigo[MAX_ACOES];
char escola[MAX_ACOES][TAM_TEXTO];
char tema[MAX_ACOES][TAM_TEXTO];
char dataPrevista[MAX_ACOES][TAM_DATA];
char publicoAlvo[MAX_ACOES][TAM_TEXTO];
char responsavel[MAX_ACOES][TAM_TEXTO];
int qtdPrevista[MAX_ACOES];
int qtdEfetiva[MAX_ACOES];
int situacao[MAX_ACOES];
int total = 0;         /* quantas ações já foram cadastradas */

/* ---------- Funções de leitura ---------- */

/* Quando um texto é cortado no limite, evita que uma letra acentuada (que em
   UTF-8 ocupa 2 ou mais bytes) fique pela metade. Devolve o novo tamanho. */
int ajustarCorteUtf8(char texto[], int tam) {
    int inicio;
    int esperado;
    unsigned char lider;

    inicio = tam - 1;
    /* volta até o primeiro byte do último caractere (bytes 10xxxxxx são continuação) */
    while (inicio > 0 && ((unsigned char) texto[inicio] & 0xC0) == 0x80) {
        inicio--;
    }
    if (inicio >= 0) {
        lider = (unsigned char) texto[inicio];
        if (lider >= 0xF0) {
            esperado = 4;
        } else if (lider >= 0xE0) {
            esperado = 3;
        } else if (lider >= 0xC0) {
            esperado = 2;
        } else {
            esperado = 1;
        }
        if (tam - inicio < esperado) {
            tam = inicio;   /* caractere incompleto: descarta ele */
        }
    }
    return tam;
}

/* Lê uma linha de texto (aceita espaços). Se o usuário só apertar Enter, fica vazio.
   Devolve 1 se o texto digitado era maior que o limite (e foi cortado), ou 0.
   Se a entrada de dados acabar (EOF), encerra o programa. */
int lerTexto(char destino[], int tamanho) {
    int i;
    int c;
    int cortado;
    i = 0;
    cortado = 0;
    c = getchar();
    if (c == EOF) {
        printf("\n\nFim da entrada de dados. Encerrando o programa.\n");
        exit(0);
    }
    while (c != '\n' && c != EOF) {
        if (c != '\r') {               /* ignora o '\r' de quebras de linha do Windows */
            if (i < tamanho - 1) {
                destino[i] = c;
                i++;
            } else {
                cortado = 1;
            }
        }
        c = getchar();
    }
    if (cortado == 1) {
        i = ajustarCorteUtf8(destino, i);
    }
    destino[i] = '\0';
    return cortado;
}

/* Lê um número inteiro (zero ou positivo). Se o usuário digitar algo que não
   é um número inteiro válido (letras, "12abc", vazio, negativo, número grande
   demais), devolve -1. */
int lerInteiro(void) {
    char linha[TAM_LINHA];
    int i;
    int n;
    int digito;
    int valido;

    valido = 1;
    if (lerTexto(linha, TAM_LINHA) == 1) {
        valido = 0;                    /* linha grande demais */
    }

    i = 0;
    n = 0;
    while (linha[i] == ' ' || linha[i] == '\t') {
        i++;
    }
    if (linha[i] < '0' || linha[i] > '9') {
        valido = 0;                    /* vazio, sinal ou letra */
    }
    while (valido == 1 && linha[i] >= '0' && linha[i] <= '9') {
        digito = linha[i] - '0';
        if (n > (INT_MAX - digito) / 10) {
            valido = 0;                /* número não cabe em um int */
        } else {
            n = n * 10 + digito;
            i++;
        }
    }
    while (valido == 1 && (linha[i] == ' ' || linha[i] == '\t')) {
        i++;
    }
    if (valido == 1 && linha[i] != '\0') {
        valido = 0;                    /* sobrou algo depois do número */
    }

    if (valido == 0) {
        n = -1;
    }
    return n;
}

/* ---------- Funções auxiliares ---------- */

char minuscula(char c) {
    if (c >= 'A' && c <= 'Z') {
        c = c + 32;
    }
    return c;
}

/* Em UTF-8, as letras maiúsculas acentuadas (À, Á, Â, Ã, Ç, É, Ó, Ú...) são o
   byte 0xC3 seguido de 0x80 a 0x9E; a minúscula é esse segundo byte + 32.
   (0x97 é o sinal de multiplicação e não é letra.) */
char minusculaAcentuada(char anterior, char c) {
    unsigned char a;
    unsigned char u;
    a = (unsigned char) anterior;
    u = (unsigned char) c;
    if (a == 0xC3 && u >= 0x80 && u <= 0x9E && u != 0x97) {
        c = (char) (u + 32);
    }
    return c;
}

int ehDigito(char c) {
    return c >= '0' && c <= '9';
}

/* Verifica se a data está no formato dd/mm/aaaa e se existe no calendário
   (considera meses com 30/31 dias e anos bissextos). Devolve 1 ou 0. */
int dataValida(char d[]) {
    int dia;
    int mes;
    int ano;
    int diasNoMes;
    int valida;

    valida = 1;
    if (!(ehDigito(d[0]) && ehDigito(d[1]) && d[2] == '/'
          && ehDigito(d[3]) && ehDigito(d[4]) && d[5] == '/'
          && ehDigito(d[6]) && ehDigito(d[7]) && ehDigito(d[8]) && ehDigito(d[9])
          && d[10] == '\0')) {
        valida = 0;
    }

    if (valida == 1) {
        dia = (d[0] - '0') * 10 + (d[1] - '0');
        mes = (d[3] - '0') * 10 + (d[4] - '0');
        ano = (d[6] - '0') * 1000 + (d[7] - '0') * 100 + (d[8] - '0') * 10 + (d[9] - '0');

        if (ano < 1 || mes < 1 || mes > 12) {
            valida = 0;
        } else {
            if (mes == 2) {
                if ((ano % 4 == 0 && ano % 100 != 0) || ano % 400 == 0) {
                    diasNoMes = 29;
                } else {
                    diasNoMes = 28;
                }
            } else if (mes == 4 || mes == 6 || mes == 9 || mes == 11) {
                diasNoMes = 30;
            } else {
                diasNoMes = 31;
            }
            if (dia < 1 || dia > diasNoMes) {
                valida = 0;
            }
        }
    }
    return valida;
}

/* Compara dois textos. Devolve 1 se forem iguais e 0 se forem diferentes.
   Se ignorarCaixa for 1, "Escola" e "escola" são considerados iguais. */
int textosIguais(char a[], char b[], int ignorarCaixa) {
    int i;
    int iguais;
    char x;
    char y;
    i = 0;
    iguais = 1;
    while (iguais == 1 && a[i] != '\0' && b[i] != '\0') {
        x = a[i];
        y = b[i];
        if (ignorarCaixa == 1) {
            x = minuscula(x);
            y = minuscula(y);
            if (i > 0) {
                x = minusculaAcentuada(a[i - 1], x);
                y = minusculaAcentuada(b[i - 1], y);
            }
        }
        if (x != y) {
            iguais = 0;
        }
        i++;
    }
    if (iguais == 1 && a[i] != b[i]) {
        iguais = 0;
    }
    return iguais;
}

/* Procura um código entre as ações cadastradas. Devolve a posição ou -1. */
int buscarCodigo(int cod) {
    int i;
    int posicao;
    posicao = -1;
    for (i = 0; i < total; i++) {
        if (codigo[i] == cod) {
            posicao = i;
        }
    }
    return posicao;
}

void mostrarSituacao(int s) {
    if (s == PLANEJADA) {
        printf("Planejada");
    } else if (s == REALIZADA) {
        printf("Realizada");
    } else {
        printf("Cancelada");
    }
}

void mostrarAcao(int i) {
    printf("--------------------------------------\n");
    printf("Código: %d\n", codigo[i]);
    printf("Escola: %s\n", escola[i]);
    printf("Tema: %s\n", tema[i]);
    printf("Data prevista: %s\n", dataPrevista[i]);
    printf("Público-alvo: %s\n", publicoAlvo[i]);
    printf("Responsável: %s\n", responsavel[i]);
    printf("Participantes previstos: %d\n", qtdPrevista[i]);
    printf("Situação: ");
    mostrarSituacao(situacao[i]);
    printf("\n");
    if (situacao[i] == REALIZADA) {
        printf("Participantes efetivos: %d\n", qtdEfetiva[i]);
    }
}

/* ---------- Login e menu ---------- */

void telaLogin(void) {
    char usuario[30];
    char senha[30];
    int logado;
    logado = 0;

    printf("=== PSE EM AÇÃO ===\n");
    while (logado == 0) {
        printf("\nUsuário: ");
        lerTexto(usuario, 30);
        printf("Senha: ");
        lerTexto(senha, 30);

        if (textosIguais(usuario, "admin", 0) == 1 && textosIguais(senha, "1234", 0) == 1) {
            logado = 1;
        } else {
            printf("Usuário ou senha incorretos. Tente novamente.\n");
        }
    }
    printf("\nLogin realizado com sucesso!\n");
}

void mostrarMenu(void) {
    printf("\n===== MENU PRINCIPAL =====\n");
    printf("1 - Cadastrar ação\n");
    printf("2 - Listar ações\n");
    printf("3 - Atualizar situação\n");
    printf("4 - Gerar resumo\n");
    printf("5 - Pesquisar ação\n");
    printf("6 - Sair\n");
    printf("Escolha uma opção: ");
}

/* ---------- Funcionalidades ---------- */

void cadastrarAcao(void) {
    int i;
    int cod;
    i = total;   /* a nova ação será gravada na posição "total" */

    printf("\n=== CADASTRAR AÇÃO ===\n");

    if (total >= MAX_ACOES) {
        printf("Erro: limite de %d ações atingido.\n", MAX_ACOES);
        return;
    }

    printf("Código (número maior que zero): ");
    cod = lerInteiro();
    if (cod <= 0) {
        printf("Erro: código inválido.\n");
        return;
    }
    if (buscarCodigo(cod) != -1) {
        printf("Erro: já existe uma ação com esse código.\n");
        return;
    }

    printf("Escola: ");
    lerTexto(escola[i], TAM_TEXTO);
    printf("Tema: ");
    lerTexto(tema[i], TAM_TEXTO);
    printf("Data prevista (dd/mm/aaaa): ");
    if (lerTexto(dataPrevista[i], TAM_DATA) == 1 || dataValida(dataPrevista[i]) == 0) {
        printf("Erro: data inválida. Use o formato dd/mm/aaaa com uma data existente.\n");
        return;
    }
    printf("Público-alvo: ");
    lerTexto(publicoAlvo[i], TAM_TEXTO);
    printf("Responsável: ");
    lerTexto(responsavel[i], TAM_TEXTO);

    if (escola[i][0] == '\0' || tema[i][0] == '\0' || dataPrevista[i][0] == '\0'
        || publicoAlvo[i][0] == '\0' || responsavel[i][0] == '\0') {
        printf("Erro: todos os campos são obrigatórios.\n");
        return;
    }

    printf("Quantidade prevista de participantes: ");
    qtdPrevista[i] = lerInteiro();
    if (qtdPrevista[i] < 0) {
        printf("Erro: quantidade inválida (não pode ser negativa).\n");
        return;
    }

    codigo[i] = cod;
    qtdEfetiva[i] = 0;
    situacao[i] = PLANEJADA;
    total++;
    printf("Ação cadastrada com sucesso! Situação inicial: Planejada.\n");
}

void listarAcoes(void) {
    int i;

    printf("\n=== AÇÕES CADASTRADAS ===\n");
    if (total == 0) {
        printf("Nenhuma ação cadastrada.\n");
        return;
    }

    for (i = 0; i < total; i++) {
        mostrarAcao(i);
    }
    printf("--------------------------------------\n");
    printf("Total de ações: %d\n", total);
}

void pesquisarAcao(void) {
    int opcao;
    int i;
    int encontrados;
    char busca[TAM_TEXTO];

    printf("\n=== PESQUISAR AÇÃO ===\n");
    printf("1 - Por código\n");
    printf("2 - Por escola\n");
    printf("3 - Por tema\n");
    printf("Escolha: ");
    opcao = lerInteiro();
    encontrados = 0;

    if (opcao == 1) {
        printf("Digite o código: ");
        i = buscarCodigo(lerInteiro());
        if (i != -1) {
            mostrarAcao(i);
            encontrados = 1;
        }
    } else if (opcao == 2) {
        printf("Digite o nome da escola: ");
        lerTexto(busca, TAM_TEXTO);
        for (i = 0; i < total; i++) {
            if (textosIguais(escola[i], busca, 1) == 1) {
                mostrarAcao(i);
                encontrados++;
            }
        }
    } else if (opcao == 3) {
        printf("Digite o tema: ");
        lerTexto(busca, TAM_TEXTO);
        for (i = 0; i < total; i++) {
            if (textosIguais(tema[i], busca, 1) == 1) {
                mostrarAcao(i);
                encontrados++;
            }
        }
    } else {
        printf("Erro: opção de pesquisa inválida.\n");
        return;
    }

    if (encontrados == 0) {
        printf("Nenhuma ação encontrada.\n");
    } else {
        printf("--------------------------------------\n");
        printf("%d ação(ões) encontrada(s).\n", encontrados);
    }
}

void atualizarSituacao(void) {
    int cod;
    int i;
    int opcao;
    int efetiva;

    printf("\n=== ATUALIZAR SITUAÇÃO ===\n");
    if (total == 0) {
        printf("Nenhuma ação cadastrada.\n");
        return;
    }

    printf("Código da ação: ");
    cod = lerInteiro();
    i = buscarCodigo(cod);
    if (i == -1) {
        printf("Erro: ação não encontrada.\n");
        return;
    }

    mostrarAcao(i);
    printf("\nNova situação:\n");
    printf("1 - Planejada\n");
    printf("2 - Realizada\n");
    printf("3 - Cancelada\n");
    printf("Escolha: ");
    opcao = lerInteiro();

    if (opcao == PLANEJADA || opcao == CANCELADA) {
        situacao[i] = opcao;
        qtdEfetiva[i] = 0;
        printf("Situação atualizada com sucesso!\n");
    } else if (opcao == REALIZADA) {
        printf("Quantidade efetiva de participantes: ");
        efetiva = lerInteiro();
        if (efetiva < 0) {
            printf("Erro: quantidade inválida (não pode ser negativa).\n");
            return;
        }
        situacao[i] = REALIZADA;
        qtdEfetiva[i] = efetiva;
        printf("Situação atualizada com sucesso!\n");
    } else {
        printf("Erro: opção de situação inválida.\n");
    }
}

void gerarResumo(void) {
    int i;
    int planejadas;
    int realizadas;
    int canceladas;
    int totalEfetivo;
    int previstoRealizadas;
    float percentual;

    planejadas = 0;
    realizadas = 0;
    canceladas = 0;
    totalEfetivo = 0;
    previstoRealizadas = 0;

    for (i = 0; i < total; i++) {
        if (situacao[i] == PLANEJADA) {
            planejadas++;
        } else if (situacao[i] == REALIZADA) {
            realizadas++;
            totalEfetivo = totalEfetivo + qtdEfetiva[i];
            previstoRealizadas = previstoRealizadas + qtdPrevista[i];
        } else {
            canceladas++;
        }
    }

    printf("\n=== RESUMO GERAL ===\n");
    printf("Total de ações cadastradas: %d\n", total);
    printf("Ações planejadas: %d\n", planejadas);
    printf("Ações realizadas: %d\n", realizadas);
    printf("Ações canceladas: %d\n", canceladas);
    printf("Total de participantes (ações realizadas): %d\n", totalEfetivo);
    printf("Participantes previstos (ações realizadas): %d\n", previstoRealizadas);

    if (realizadas == 0) {
        printf("Percentual de participação: não calculável (nenhuma ação realizada).\n");
    } else if (previstoRealizadas == 0) {
        printf("Percentual de participação: não calculável (ações realizadas tinham 0 participantes previstos).\n");
    } else {
        percentual = 100.0 * totalEfetivo / previstoRealizadas;
        printf("Percentual de participação em relação ao previsto: %.1f%%\n", percentual);
    }
}

/* ---------- Programa principal ---------- */

int main(void) {
    int opcao;

#ifdef _WIN32
    SetConsoleOutputCP(CP_UTF8);   /* faz o terminal do Windows exibir os acentos corretamente */
#endif

    telaLogin();

    opcao = 0;
    while (opcao != 6) {
        mostrarMenu();
        opcao = lerInteiro();

        if (opcao == 1) {
            cadastrarAcao();
        } else if (opcao == 2) {
            listarAcoes();
        } else if (opcao == 3) {
            atualizarSituacao();
        } else if (opcao == 4) {
            gerarResumo();
        } else if (opcao == 5) {
            pesquisarAcao();
        } else if (opcao == 6) {
            printf("\nEncerrando o programa. Até logo!\n");
        } else {
            printf("\nErro: opção inexistente no menu.\n");
        }
    }

    return 0;
}
